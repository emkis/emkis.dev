---
import {
  AnalyticsLoader,
  ContainContent,
  Footer,
  IconLoader,
  MetaBase,
  MetaDescription,
  MetaOpenGraph,
  MetaTitle,
  metadata,
  NavBar,
  ViewTransitionsLoader,
} from '@/shell'
import { Fonts, GlobalStyles, Heading, SectionStack, Stack, Text } from '@/ui'
import {
  ArticleList,
  ArticleListItem,
  getArticlePathname,
  getSortedArticles,
} from '@/writing'

const articles = await getSortedArticles()
---

<!doctype html>
<html lang="en">
	<head>
    <AnalyticsLoader />
    <GlobalStyles />
    <ViewTransitionsLoader />
		<Fonts />
    <IconLoader />
		<MetaBase />
		<MetaTitle />
		<MetaDescription description={metadata.description} />
		<MetaOpenGraph type="website" title={metadata.title} description={metadata.description} />
	</head>
	<body>
	  <ContainContent>
  	  <NavBar />
  		<SectionStack as="main">
        <Stack as="section" spacing="8px">
          <Heading level="1">Nicolas Jardim</Heading>
          <Text color="secondary" as="h2">
            Frontend engineer based in Lisbon
          </Text>
        </Stack>

        <Stack as="section" spacing="24px">
          <Heading level="4" as="h2">
            About me
          </Heading>
          <Text as="p">
            I build stable Frontend applications that last.
            <br>
            My background is crafting user-facing UIs for web and mobile, with a strong focus on quality and detail. I care as much about how things look, as how they are built to scale over time. By thinking deeply about API design, trade-offs, and architecture, I help products to move fast, maintain quality, and evolve with confidence.
          </Text>
        </Stack>

        <Stack as="section" spacing="16px">
          <Heading level="4" as="h2">
            Latest writing
          </Heading>
          <ArticleList>
            {articles.map((post) => (
              <ArticleListItem
                variant="long"
                publishedAt={new Date(post.data.published_at)}
                color={post.data.color}
                pathname={getArticlePathname(post)}
              >
                {post.data.title}
              </ArticleListItem>
            ))}
          </ArticleList>
        </Stack>

        <Stack as="section" spacing="24px">
          <Heading level="4" as="h2">
            Things I believe
          </Heading>
          <ol class="beliefs" role="list">
            <li class="belief">
              <blockquote>
                <Text>The magic is in the details</Text>
              </blockquote>
            </li>
            <li class="belief">
              <blockquote>
                <Text>Make things great today not tomorrow</Text>
              </blockquote>
            </li>
            <li class="belief">
              <blockquote>
                <Text>
                  Small improvements add up over time to massive results
                </Text>
              </blockquote>
            </li>
            <li class="belief">
              <blockquote>
                <Text>
                  Quality is contagious, don't tolerate <Text as="a" decoration="underline" href="https://en.wikipedia.org/wiki/Broken_windows_theory" target="_blank" rel="noopener">broken windows</Text>
                </Text>
              </blockquote>
            </li>
            <li class="belief">
              <blockquote>
                <Text>Small teams ship faster</Text>
              </blockquote>
            </li>
          </ol>
        </Stack>
      </SectionStack>
      <Footer />
		</ContainContent>
	</body>
</html>

<style>
.beliefs {
  list-style: none;
  padding: 0;
  margin: 0px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.belief {
  position: relative;
  padding-left: 36px;

  > blockquote {
    margin: 0;
  }

  &::before {
    content: "“";
    position: absolute;
    font-family: var(--font-heading);
    font-size: 3rem; /* 48px */
    font-weight: var(--font-heading-weight);
    top: 0;
    left: 0;
    height: 100%;
    line-height: 1;
    color: var(--slate-12);
  }
}
</style>
