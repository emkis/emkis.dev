---
import { render } from 'astro:content'
import {
  AnalyticsLoader,
  ContainContent,
  Footer,
  IconLoader,
  MetaBase,
  MetaDescription,
  MetaOpenGraph,
  MetaTitle,
  NavBar,
} from '@/shell'
import { Fonts, GlobalStyles, Heading, Text } from '@/ui'
import { type Article, getSortedArticles, StructuredData } from '@/writing'
import './article.css'

// biome-ignore lint/style/useExportsLast: Astro requires this export
export async function getStaticPaths() {
  const articles = await getSortedArticles()
  return articles.map((article) => ({
    props: article,
    params: {
      slug: article.id,
    },
  }))
}

type Props = Article

const article = Astro.props
const { Content, remarkPluginFrontmatter } = await render(article)
const publishedDate = new Date(article.data.published_at)
const updatedDate = article.data.updated_at
  ? new Date(article.data.updated_at)
  : undefined
const articleReadingTime = remarkPluginFrontmatter.minutesToRead

const formatDate = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<!doctype html>
<html lang="en">
	<head>
		<AnalyticsLoader />
		<GlobalStyles />
		<Fonts />
		<IconLoader />
		<MetaBase />
		<MetaTitle title={article.data.title} />
		<MetaDescription description={article.data.description} />
		<MetaOpenGraph
		  type="article"
		  title={article.data.title}
		  description={article.data.description}
		  publishedAt={article.data.published_at}
		  updatedAt={article.data.updated_at}
		/>
		<StructuredData
		  title={article.data.title}
		  description={article.data.description}
		  publishedAt={article.data.published_at}
		  updatedAt={article.data.updated_at}
		/>
	</head>
	<body>
	  <ContainContent>
  	  <NavBar />
  		<main>
        <article>
          <header class="article-header">
            <Heading level="1">{article.data.title}</Heading>
            <div class="article-meta">
              <Text size="small" color="secondary">Published <time datetime={publishedDate.toISOString()}>{formatDate.format(publishedDate)}</time></Text>
              {updatedDate && (
                <Text size="small" color="secondary">Updated <time datetime={updatedDate.toISOString()}>{formatDate.format(updatedDate)}</time></Text>
              )}
              <Text size="small" color="secondary">{articleReadingTime}</Text>
            </div>
            <hr class="article-header-rule" aria-hidden="true" />
          </header>
          <div class="article-prose">
            <Content />
          </div>
        </article>
      </main>
      <Footer />
		</ContainContent>
	</body>
</html>

<style>
  .article-header {
    padding-top: var(--space-section);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .article-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .article-header-rule {
    border: none;
    height: 1px;
    background-color: var(--slate-6);
    margin: 8px 0 0;
  }

  /* Desktop breakpoint, see typography.css */
  @media (min-width: 45rem) {
    .article-meta {
      flex-direction: row;
      align-items: center;
      gap: 8px;
    }

    .article-meta > * + *::before {
      content: "·";
      margin-right: 6px;
    }
  }
</style>
