---
import {
  AnalyticsLoader,
  ContainContent,
  Footer,
  IconLoader,
  MetaBase,
  MetaDescription,
  MetaOpenGraph,
  MetaTitle,
  NavBar,
} from '@/shell'
import { Fonts, GlobalStyles, Heading, SectionStack, Stack, Text } from '@/ui'
import {
  ArticleList,
  ArticleListItem,
  getArticlePathname,
  getSortedArticlesByYear,
} from '@/writing'

const articlesByYear = await getSortedArticlesByYear()
---

<!doctype html>
<html lang="en">
	<head>
		<AnalyticsLoader />
		<GlobalStyles />
		<Fonts />
		<IconLoader />
		<MetaBase />
		<MetaTitle title="Writing" />
		<MetaDescription description="Articles by Nicolas Jardim on frontend engineering, design systems, and developer experience." />
		<MetaOpenGraph type="website" title="Writing – Nicolas Jardim" description="Articles by Nicolas Jardim on frontend engineering, design systems, and developer experience." />
	</head>
	<body>
		<ContainContent>
		  <NavBar />
			<SectionStack as="main">
	      <Stack as="section" spacing="8px">
					<Heading level="1">Writing</Heading>
					<Text as="p" color="secondary">Thoughts, ideas, and notes on building software.</Text>
				</Stack>

				{Array.from(articlesByYear).map(([year, articles]) => (
					<Stack as="section" spacing="16px">
						<Heading level="4">{year}</Heading>
						<ArticleList>
							{articles.map((post) => (
								<ArticleListItem
									variant="compact"
									publishedAt={new Date(post.data.published_at)}
									color={post.data.color}
									pathname={getArticlePathname(post)}
								>
									{post.data.title}
								</ArticleListItem>
							))}
						</ArticleList>
					</Stack>
				))}
			</SectionStack>
      <Footer />
		</ContainContent>
	</body>
</html>
