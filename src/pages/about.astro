---
import {
  AnalyticsLoader,
  ContainContent,
  Footer,
  IconLoader,
  MetaBase,
  MetaDescription,
  MetaOpenGraph,
  MetaTitle,
  NavBar,
} from '@/shell'
import { Fonts, GlobalStyles, Heading, SectionStack, Stack, Text } from '@/ui'
---

<!doctype html>
<html lang="en">
	<head>
		<AnalyticsLoader />
		<GlobalStyles />
		<Fonts />
		<IconLoader />
		<MetaBase />
		<MetaTitle title="About" />
		<MetaDescription description="Frontend engineer based in Lisbon. I build design systems, craft developer tooling, and obsess over well-made UIs." />
		<MetaOpenGraph type="website" title="About – Nicolas Jardim" description="Frontend engineer based in Lisbon. I build design systems, craft developer tooling, and obsess over well-made UIs." />
	</head>
	<body>
	  <ContainContent>
  	  <NavBar />
  		<SectionStack as="main">
        <Stack as="section" spacing="8px">
          <Heading level="1">About</Heading>
          <Text color="secondary" as="h2">
            I still need to write things here.
          </Text>
        </Stack>
      </SectionStack>
      <Footer />
		</ContainContent>
	</body>
</html>
