---
import {
  AnalyticsLoader,
  ContainContent,
  Footer,
  IconLoader,
  MetaBase,
  MetaDescription,
  MetaOpenGraph,
  MetaTitle,
  NavBar,
} from '@/shell'
import { Fonts, GlobalStyles, Heading, SectionStack, Stack, Text } from '@/ui'
---

<!doctype html>
<html lang="en">
  <head>
    <AnalyticsLoader />
    <GlobalStyles />
    <Fonts />
    <IconLoader />
    <MetaBase />
    <MetaTitle title="Contact" />
    <MetaDescription description="Reach out to Nicolas Jardim to discuss frontend engineering, design systems, or collaborations." />
    <MetaOpenGraph type="website" title="Contact – Nicolas Jardim" description="Reach out to Nicolas Jardim to discuss frontend engineering, design systems, or collaborations." />
  </head>
  <body>
    <ContainContent>
      <NavBar />
      <SectionStack as="main">
        <section>
          <Stack spacing="48px">
            <Stack spacing="16px">
              <Heading level="1">Contact</Heading>
              <Text color="secondary">
                If something I wrote resonated with you, I'd love to hear about it. Feel free to send me a message and tell me what caught your attention. If you want to go deeper, let's nerd out about it.
              </Text>
            </Stack>

            <nav class="contact-links">
              <Text as="a" color="secondary" decoration="underline" href="https://linkedin.com/in/nicolas-jardim" target="_blank" rel="noopener">LinkedIn</Text>
              <Text as="a" color="secondary" decoration="underline" href="https://x.com/emkisn" target="_blank" rel="noopener">X (Twitter)</Text>
              <Text as="a" color="secondary" decoration="underline" href="https://github.com/emkis" target="_blank" rel="noopener">GitHub</Text>
              <Text as="a" color="secondary" decoration="underline" href="mailto:nicolasemkis@gmail.com">Email</Text>
            </nav>
          </Stack>
        </section>
      </SectionStack>
      <Footer />
    </ContainContent>
  </body>
</html>

<style>
.contact-links {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* Desktop breakpoint, see typography.css */
@media (min-width: 45rem) {
  .contact-links {
    flex-direction: row;
  }
}
</style>
