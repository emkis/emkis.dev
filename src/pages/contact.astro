---
import {
  AnalyticsLoader,
  ContainContent,
  Footer,
  IconLoader,
  MetaBase,
  MetaDescription,
  MetaOpenGraph,
  MetaTitle,
  NavBar,
  ViewTransitionsLoader,
} from '@/shell'
import {
  ArrowIcon,
  Fonts,
  GlobalStyles,
  Heading,
  SectionStack,
  Stack,
  Text,
} from '@/ui'

const contactLinks = [
  {
    name: 'LinkedIn',
    handle: 'nicolas-jardim',
    href: 'https://linkedin.com/in/nicolas-jardim',
  },
  {
    name: 'GitHub',
    handle: 'emkis',
    href: 'https://github.com/emkis',
  },
  {
    name: 'X',
    handle: '@emkisn',
    href: 'https://x.com/emkisn',
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <AnalyticsLoader />
    <GlobalStyles />
    <ViewTransitionsLoader />
    <Fonts />
    <IconLoader />
    <MetaBase />
    <MetaTitle title="Contact" />
    <MetaDescription description="Reach out to Nicolas Jardim to discuss frontend engineering, design systems, or collaborations." />
    <MetaOpenGraph type="website" title="Contact – Nicolas Jardim" description="Reach out to Nicolas Jardim to discuss frontend engineering, design systems, or collaborations." />
  </head>
  <body>
    <ContainContent>
      <NavBar />
      <SectionStack as="main">
        <section>
          <Stack spacing="48px">
            <Stack spacing="16px">
              <Heading level="1">Contact</Heading>
              <Text color="secondary">
                If something I wrote resonated with you, I'd love to hear about it. Feel free to send me a message and tell me what caught your attention. If you want to go deeper, let's nerd out about it.
              </Text>
            </Stack>

            <ul class="contact-links">
              {contactLinks.map((link) => {
                const isExternal = link.href.startsWith('https')

                return (
                  <li>
                    <a
                      class="contact-link"
                      href={link.href}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener' : undefined}
                    >
                      <Text>{link.name}</Text>
                      <Text color="secondary" class="contact-handle">{link.handle}</Text>
                      <ArrowIcon class="contact-arrow" direction={isExternal ? 'up-right' : 'right'} />
                    </a>
                  </li>
                )
              })}
            </ul>
          </Stack>
        </section>
      </SectionStack>
      <Footer />
    </ContainContent>
  </body>
</html>

<style>
.contact-links {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1px solid var(--slate-5);
}

.contact-links > li {
  border-bottom: 1px solid var(--slate-5);
}

.contact-link {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 12px;
  margin-inline: -12px;
  border-radius: 12px;
  text-decoration: none;
  transition: background-color 150ms ease;

  &:hover {
    background-color: var(--slate-3);
  }
}

.contact-handle {
  margin-left: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.contact-link :global(.contact-arrow) {
  flex-shrink: 0;
  color: var(--slate-9);
}
</style>
