---
import {
  AnalyticsLoader,
  ContainContent,
  Footer,
  IconLoader,
  MetaBase,
  MetaDescription,
  MetaOpenGraph,
  MetaTitle,
  NavBar,
  ViewTransitionsLoader,
} from '@/shell'
import { Fonts, GlobalStyles, Heading, SectionStack, Stack, Text } from '@/ui'
---

<!doctype html>
<html lang="en">
	<head>
		<AnalyticsLoader />
		<GlobalStyles />
		<ViewTransitionsLoader />
		<Fonts />
		<IconLoader />
		<MetaBase />
		<MetaTitle title="Not found" />
		<MetaDescription description="Sorry, the page you're looking for doesn't exist." />
		<MetaOpenGraph type="website" title="Not found – Nicolas Jardim" description="Sorry, the page you're looking for doesn't exist." />
	</head>
	<body>
	  <ContainContent>
  	  <NavBar />
  		<SectionStack as="main">
        <Stack as="section" spacing="8px">
          <Heading level="1">Not found</Heading>
          <Text color="secondary" as="h2">
	          Sorry, the page you're looking for doesn't exist.
          </Text>
        </Stack>
      </SectionStack>
      <Footer />
		</ContainContent>
	</body>
</html>
