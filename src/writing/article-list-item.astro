---
import type { HTMLAttributes } from 'astro/types'
import { Text } from '@/ui'

type ArticleListItemVariant = 'compact' | 'long'

interface Props extends HTMLAttributes<'li'> {
  publishedAt: Date
  color: string
  pathname: string
  variant?: ArticleListItemVariant
}

const {
  color,
  publishedAt,
  pathname,
  variant = 'long',
  ...restProps
} = Astro.props
const isCompact = variant === 'compact'
const formatDate = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: isCompact ? undefined : 'numeric',
})
---

<li {...restProps} class="article-listitem">
  <span
    class="article-color-block"
    aria-hidden={true}
    style={{ backgroundColor: color }}
  />
  <div class="article-info">
    <Text as="a" href={pathname} class="title-link"><slot /></Text>
    <Text as="time" datetime={publishedAt.toISOString()} color="secondary">{formatDate.format(publishedAt)}</Text>
  </div>
</li>

<style>
.article-listitem {
  --color-radius: 8px;
  --content-padding: 8px;
  --outer-radius: calc(var(--color-radius) + var(--content-padding));

  position: relative;
  display: flex;
  align-items: center;
  justify-items: flex-start;
  padding: var(--content-padding);
  margin: 0 calc(var(--content-padding) * -1);
  border-radius: var(--outer-radius);
  transition: background-color 150ms ease;

  @media (hover: hover) and (pointer: fine) {
    &:hover {
      background-color: var(--slate-4);
    }
  }

  &:has(:global(.title-link):active) {
    background-color: var(--slate-4);
  }
}

.article-color-block {
  --block-size: 70px;
  display: inline-block;
  width: var(--block-size);
  height: var(--block-size);
  border-radius: var(--color-radius);
  margin-right: 16px;
}

.article-info {
  display: flex;
  flex-direction: column;
}

/* Stretches the real, accessible title link to cover the whole row as the click/tap target */
:global(.title-link) {
  &::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
  }

  &:focus-visible {
    outline: none;

    &::after {
      outline: 2px solid var(--brown-12);
      outline-offset: -2px;
      border-radius: var(--outer-radius);
    }
  }
}
</style>
