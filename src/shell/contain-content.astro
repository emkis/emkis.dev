---
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }>

const { as, class: className, ...restProps } = Astro.props
const Element = as || 'div'
---

<Element {...restProps} class:list={["contain-content", className]}>
  <slot />
</Element>

<style>
.contain-content {
  /* Measured in body text so the line length stays comfortable to read */
  font-family: var(--font-body);
  font-size: var(--text-size);
  width: min(68ch, 100% - 32px);
  margin: 0 auto;
  display: grid;
  /* Keeps wide code blocks from stretching the page on mobile */
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: auto 1fr auto;
  grid-template-areas: "nav" "main" "footer";
  min-height: 100vh;
  min-height: 100svh;

  @media (max-width: 44.99rem) {
    padding-block: 16px;
  }
}

.contain-content > nav {
  grid-area: nav;
}

.contain-content > main {
  grid-area: main;
}

.contain-content > footer {
  grid-area: footer;
}
</style>
