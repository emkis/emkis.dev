---
/**
 * Demo-only control to compare heading and code fonts across the site.
 * Choices are applied as `data-heading-font` / `data-mono-font` on <html>,
 * synced to the `?heading=` / `?mono=` query params (so a combination can be
 * linked) and remembered in localStorage.
 */
const groups = [
  {
    name: 'heading',
    label: 'Headings',
    options: [
      { value: 'fraunces', label: 'Fraunces' },
      { value: 'literata', label: 'Literata' },
    ],
  },
  {
    name: 'mono',
    label: 'Code',
    options: [
      { value: 'jetbrains', label: 'JetBrains Mono' },
      { value: 'plex', label: 'IBM Plex Mono' },
      { value: 'fira', label: 'Fira Code' },
      { value: 'source', label: 'Source Code Pro' },
    ],
  },
]
---

<!-- Alternative fonts only used by this demo control. -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400..600&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Source+Code+Pro:ital,wght@0,400..600;1,400..600&display=swap" />

<script is:inline>
  // Runs as early as possible to avoid a flash of the default fonts.
  ;(() => {
    const params = new URLSearchParams(location.search)
    for (const name of ['heading', 'mono']) {
      let value = params.get(name)
      if (!value) {
        try {
          value = localStorage.getItem(`typography-lab-${name}`)
        } catch {}
      }
      if (value) {
        document.documentElement.dataset[`${name}Font`] = value
      }
    }
  })()
</script>

<div class="lab" aria-label="Typography lab">
  {groups.map((group) => (
    <div class="group" role="group" aria-label={group.label}>
      <span class="group-label">{group.label}</span>
      {group.options.map((option, index) => (
        <button
          type="button"
          class="option"
          data-group={group.name}
          data-value={option.value}
          data-default={index === 0 ? '' : undefined}
        >
          {option.label}
        </button>
      ))}
    </div>
  ))}
</div>

<script>
  const root = document.documentElement
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '.lab [data-group]',
  )

  function current(group: string) {
    return root.dataset[`${group}Font`]
  }

  function sync() {
    for (const button of buttons) {
      const group = button.dataset.group ?? ''
      const active = current(group)
      const isActive = active
        ? button.dataset.value === active
        : button.dataset.default !== undefined
      button.setAttribute('aria-pressed', String(isActive))
    }
  }

  function select(group: string, value: string, isDefault: boolean) {
    const url = new URL(location.href)
    if (isDefault) {
      delete root.dataset[`${group}Font`]
      url.searchParams.delete(group)
    } else {
      root.dataset[`${group}Font`] = value
      url.searchParams.set(group, value)
    }
    try {
      localStorage.setItem(`typography-lab-${group}`, value)
    } catch {
      // Storage can be unavailable (private mode); the URL still works.
    }
    history.replaceState(null, '', url)
    sync()
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      select(
        button.dataset.group ?? '',
        button.dataset.value ?? '',
        button.dataset.default !== undefined,
      )
    })
  }

  sync()
</script>

<style is:global>
  /* Keeps the floating control from covering the footer */
  body {
    padding-bottom: 96px;
  }

  html[data-heading-font="literata"] {
    --font-heading: "Literata", Georgia, serif;
    --font-heading-weight: 700;
    --font-heading-variation: normal;
  }

  html[data-mono-font="plex"] {
    --font-mono: "IBM Plex Mono", ui-monospace, monospace;
  }

  html[data-mono-font="fira"] {
    --font-mono: "Fira Code", ui-monospace, monospace;
  }

  html[data-mono-font="source"] {
    --font-mono: "Source Code Pro", ui-monospace, monospace;
  }
</style>

<style>
  .lab {
    position: fixed;
    inset-inline: 0;
    bottom: 16px;
    width: max-content;
    max-width: calc(100% - 32px);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 12px;
    padding: 6px 8px;
    background-color: var(--slate-2);
    border: 1px solid var(--slate-6);
    border-radius: 16px;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
    z-index: 10;
    font-family: var(--font-mono);
  }

  .group {
    max-width: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    overflow-x: auto;
  }

  .group-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--slate-10);
    padding-inline: 4px 6px;
  }

  .option {
    font-family: inherit;
    font-size: 0.75rem;
    white-space: nowrap;
    padding: 5px 10px;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--slate-11);
    cursor: pointer;
  }

  .option:hover {
    color: var(--slate-12);
    background-color: var(--slate-4);
  }

  .option[aria-pressed="true"] {
    color: var(--slate-1);
    background-color: var(--slate-12);
  }
</style>
