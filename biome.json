{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules/**/*",
      "!**/pnpm-lock.yaml",
      "!**/dist",
      "!**/public",
      "!**/.astro",
      "!**/.gitignore"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": "on",
      "style": {
        "preset": "all",
        "noTernary": "off"
      },
      "a11y": "on",
      "correctness": "on",
      "performance": "on",
      "security": "on",
      "suspicious": {
        "preset": "all",
        "noShadow": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "preset": "recommended"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/*/index.ts",
        "src/writing/markdown.ts",
        "src/content.config.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**", "astro.config.mjs"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/**", "!@/writing/collection", "../**"],
                    "message": "Import from a vertical's entry point (e.g. '@/writing'), not from its internal files. See AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/**", "!@/writing/collection", "../**"],
                    "message": "Import from a vertical's entry point (e.g. '@/writing'), not from its internal files. See AGENTS.md."
                  },
                  {
                    "group": ["@/shell", "@/writing"],
                    "message": "The ui vertical can't depend on other verticals. See AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shell/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/**", "!@/writing/collection", "../**"],
                    "message": "Import from a vertical's entry point (e.g. '@/writing'), not from its internal files. See AGENTS.md."
                  },
                  {
                    "group": ["@/writing"],
                    "message": "The shell vertical can only depend on '@/ui'. See AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/writing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/**", "!@/writing/collection", "../**"],
                    "message": "Import from a vertical's entry point (e.g. '@/writing'), not from its internal files. See AGENTS.md."
                  },
                  {
                    "group": ["@/shell"],
                    "message": "The writing vertical can only depend on '@/ui'. See AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["astro.config.mjs"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noEmptySource": "off"
          }
        }
      }
    },
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noReactSpecificProps": "off"
          },
          "style": {
            "useComponentExportOnlyModules": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "correctness": {
            "useImportExtensions": "off",
            "noUnresolvedImports": "off",
            "useQwikValidLexicalScope": "off"
          }
        }
      }
    }
  ]
}
